# LLM augmentation (optional - for offline use, leave disabled)
LLM_ENABLED=false
LLM_PROVIDER=auto
LLM_MODEL=claude-3-haiku-20240307

# LLM API keys (only needed if LLM_ENABLED=true)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database
DATABASE_URL=sqlite:///./app/harmonization.db
REDIS_URL=redis://localhost:6379/0

# ML model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Matching thresholds
CLUSTER_THRESHOLD=0.75
HIGH_CONFIDENCE=0.90
MEDIUM_CONFIDENCE=0.70
